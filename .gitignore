# Local-only tooling: pack bake/extract scripts and the personal install
# helper. Packs ship baked assets, and these reference machine-local paths
# (PX extraction, GOG install dir), so they stay out of the repo.
/tools/*
!/tools/sync-state-diff.py
!/tools/test_sync_state_diff.py
!/tools/sync-input-matrix.py
!/tools/test_sync_input_matrix.py

# Game leftovers
WA.exe
gfx.dir
sprites.dat

# Preview renders for review; never committed.
tmp/
